PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/instashop
FRONTEND_URL=http://localhost:8080
RAZORPAY_KEY_ID=<razorpay_key_id>
RAZORPAY_KEY_SECRET=<razorpay_key_secret>
RAZORPAY_WEBHOOK_SECRET=<a string you pick, pasted into the Razorpay Dashboard webhook too>
JWT_SECRET=<random_long_secret_string>
ADMIN_EMAIL=<superadmin_login_email>
ADMIN_PASSWORD=<superadmin_login_password>
RESEND_API_KEY=<resend_api_key>
RESEND_FROM=Instashop <onboarding@resend.dev>
NOTIFY_EMAIL=<where founding-seller lead notifications go, defaults to ADMIN_EMAIL>
